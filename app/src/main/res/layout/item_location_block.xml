<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/locationBlockRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="14dp">

    <!-- Monolithic Two-Tone Material 3 Expressive Location Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/locationUnifiedCard"
        style="?attr/materialCardViewFilledStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TOP ZONE: Status + Countdown + 24h Timeline (clipped cleanly to card's 28dp top corners) -->
            <LinearLayout
                android:id="@+id/heroSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorPrimaryContainer"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="12dp">

                <!-- Location Meta Row: Primary Icon + Name + (+N Pill) + Queue Pill + Edit + Drag Handle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/llPrimaryLocationHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivLocationIcon"
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_loc_home" />

                        <TextView
                            android:id="@+id/tvLocationName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textSize="15.5sp"
                            android:textStyle="bold" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardExtraLocationsCount"
                            style="?attr/materialCardViewFilledStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:visibility="gone"
                            app:cardCornerRadius="11dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <TextView
                                android:id="@+id/tvExtraLocationsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFeatureSettings="tnum"
                                android:paddingHorizontal="7dp"
                                android:paddingVertical="2dp"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardLocationQueueBadge"
                        style="?attr/materialCardViewFilledStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="11dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <TextView
                            android:id="@+id/tvLocationQueueBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <ImageButton
                        android:id="@+id/btnEditLocation"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="3dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/location_edit_desc"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_edit" />

                    <ImageView
                        android:id="@+id/ivDragHandle"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="1dp"
                        android:contentDescription="@string/location_drag_desc"
                        android:padding="5dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_drag_handle"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Status + Daily Hours -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStatusTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTotalHoursBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStatusSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <com.frankov_dev.khmlight.ui.view.TimelineBarView
                    android:id="@+id/myQueueTimelineBar"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- BOTTOM ZONE: Seamlessly attached Schedule Intervals inside the same monolithic card -->
            <LinearLayout
                android:id="@+id/intervalsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="6dp">

                <!-- Compact 1-row Schedule Header + Clickable Update Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_calendar_schedule"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/tvScheduleStripTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold" />

                    <!-- Clickable Revision Diff Pill (visible ONLY when this queue changed vs previous_schedules) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardRevisionDiffBanner"
                        style="?attr/materialCardViewFilledStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp">

                        <TextView
                            android:id="@+id/tvRevisionDiffText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="3dp"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="16dp"
                    android:alpha="0.32"
                    android:background="?attr/colorOutlineVariant" />

                <LinearLayout
                    android:id="@+id/intervalsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
